<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_prayer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_emerald"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Header: Countdown & City -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_crescent_moon"
            android:tint="#E2BE78"
            android:layout_marginEnd="6dp"
            android:contentDescription="هلال" />

        <TextView
            android:id="@+id/prayer_widget_countdown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="الصلاة القادمة: الظهر (متبقي 01:25:00)"
            android:textColor="#E2BE78"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/prayer_widget_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="القاهرة"
            android:textColor="#A0B8AD"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 5 Prayers Grid Row -->
    <LinearLayout
        android:id="@+id/prayer_widget_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="5"
        android:background="@drawable/widget_card_inner"
        android:padding="6dp"
        android:gravity="center_vertical">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/pw_box_fajr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#A0B8AD"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/pw_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04:20"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/pw_box_dhuhr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="#A0B8AD"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/pw_time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11:58"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/pw_box_asr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="#A0B8AD"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/pw_time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03:22"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/pw_box_maghrib"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="#A0B8AD"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/pw_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:55"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/pw_box_isha"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="#A0B8AD"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/pw_time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:15"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
