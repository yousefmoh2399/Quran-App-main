<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/banner_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/banner_bg_emerald"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/banner_collapsed_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_crescent_moon"
        android:contentDescription="هلال" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/banner_collapsed_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الصلاة القادمة: الظهر 11:58 ص"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/banner_collapsed_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تقرّب • القاهرة"
            android:textColor="#A0B8AD"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/banner_collapsed_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/banner_pill_gold"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="متبقي 25 د"
        android:textColor="#E2BE78"
        android:textSize="11.5sp"
        android:textStyle="bold" />

</LinearLayout>
