<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_wird"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_emerald"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Title & Streak Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="الورد القرآني 📖"
            android:textColor="#E2BE78"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wird_widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 3 أيام متتالية"
            android:textColor="#A0B8AD"
            android:textSize="11sp"
            android:background="@drawable/widget_card_inner"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <!-- Center Card: Progress and Target -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_card_inner"
        android:padding="10dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/wird_widget_plan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="هدف اليوم: 4 صفحات"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wird_widget_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 / 4 صفحات"
                android:textColor="#5CE1B6"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/wird_widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="50"
            android:progressTint="#5CE1B6"
            android:progressBackgroundTint="#2C4A3E"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/wird_widget_last_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="آخر قراءة: الصفحة 42"
            android:textColor="#A0B8AD"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Bottom Action Row: Continue Reading Button -->
    <LinearLayout
        android:id="@+id/wird_btn_continue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_btn_secondary"
        android:gravity="center"
        android:paddingVertical="7dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/wird_widget_btn_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="متابعة الورد الآن ✨"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
