<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adhanRootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_adhan_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp">

            <!-- Swipe Down Indicator -->
            <View
                android:layout_width="44dp"
                android:layout_height="4dp"
                android:background="#40FFFFFF"
                android:layout_marginBottom="16dp" />

            <!-- Moon & Crescent Icon with animation -->
            <ImageView
                android:id="@+id/ivCrescent"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:contentDescription="الهلال"
                android:src="@drawable/ic_crescent_moon"
                android:layout_marginBottom="8dp" />

            <!-- City and Date -->
            <TextView
                android:id="@+id/tvLocationAndDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_medium"
                android:textColor="#A4B3AC"
                android:textSize="13sp"
                tools:text="المنصورة • الأربعاء ٣٠ سبتمبر ٢٠٢٦" />

            <TextView
                android:id="@+id/tvHijriDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_regular"
                android:textColor="#7A8A83"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                tools:text="١٨ ربيع الأول ١٤٤٨ هـ" />

            <!-- Notification Subtitle -->
            <TextView
                android:id="@+id/tvAdhanSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/cairo_bold"
                android:textColor="#3FB597"
                android:textSize="17sp"
                tools:text="🕌 حان الآن موعد أذان الفجر" />

            <!-- Big Prayer Name in Amiri Font -->
            <TextView
                android:id="@+id/tvPrayerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/amiri_bold"
                android:textColor="#E5C365"
                android:textSize="48sp"
                android:includeFontPadding="false"
                tools:text="صلاة الفجر" />

            <!-- Prayer Exact Time -->
            <TextView
                android:id="@+id/tvPrayerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_bold"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:layout_marginBottom="20dp"
                tools:text="٠٥:٢٠ ص" />

            <!-- Next Prayer Card -->
            <LinearLayout
                android:id="@+id/cardNextPrayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_adhan_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvNextPrayerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cairo_medium"
                    android:textColor="#C3D2CB"
                    android:textSize="13sp"
                    tools:text="الصلاة القادمة: الظهر" />

                <TextView
                    android:id="@+id/tvNextPrayerCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/cairo_bold"
                    android:textColor="#3FB597"
                    android:textSize="15sp"
                    tools:text="متبقي ٠٦:٤٢:١٥" />
            </LinearLayout>

            <!-- Du'a After Adhan Card (Shown after audio or manual reveal) -->
            <LinearLayout
                android:id="@+id/cardDua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_adhan_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cairo_bold"
                    android:textColor="#E5C365"
                    android:textSize="13sp"
                    android:text="🤲 دعاء ما بعد الأذان" />

                <TextView
                    android:id="@+id/tvDuaContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/amiri_regular"
                    android:textColor="#E8EEEB"
                    android:textSize="16sp"
                    android:lineSpacingMultiplier="1.3"
                    android:text="اللَّهُمَّ رَبَّ هَذِهِ الدَّعْوَةِ التَّامَّةِ، وَالصَّلَاةِ القَائِمَةِ، آتِ مُحَمَّدًا الوَسِيلَةَ وَالفَضِيلَةَ، وَابْعَثْهُ مَقَامًا مَحْمُودًا الَّذِي وَعَدْتَهُ" />
            </LinearLayout>

            <!-- Action Buttons Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Stop Audio Button -->
                <Button
                    android:id="@+id/btnStopAdhan"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_stop_adhan"
                    android:fontFamily="@font/cairo_bold"
                    android:text="إيقاف الأذان"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <!-- "صلّيت" Button -->
                <Button
                    android:id="@+id/btnPrayed"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_prayed"
                    android:fontFamily="@font/cairo_bold"
                    android:text="صلّيت بحمد الله"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Swipe hint -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_regular"
                android:textColor="#60706A"
                android:textSize="11.5sp"
                android:text="اسحب الشاشة للأسفل للإغلاق" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
