<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/banner_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/banner_bg_emerald"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Top Header: Logo/Crescent + Title + Hijri + City -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_crescent_moon"
            android:contentDescription="شعار" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تقرّب"
            android:textColor="#E2BE78"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/banner_expanded_hijri"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=" • التاريخ الهجري"
            android:textColor="#A0B8AD"
            android:textSize="11.5sp"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/banner_expanded_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="القاهرة"
            android:textColor="#A0B8AD"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Next Prayer Card Row -->
    <LinearLayout
        android:id="@+id/banner_expanded_next_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/banner_prayer_active_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/banner_expanded_next_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🕌 الصلاة القادمة: الظهر 11:58 ص"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/banner_expanded_next_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/banner_pill_gold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="متبقي 25 د"
            android:textColor="#E2BE78"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5 Prayers Grid Row -->
    <LinearLayout
        android:id="@+id/banner_expanded_prayers_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5"
        android:layout_marginBottom="8dp">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/banner_box_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/banner_prayer_normal_bg"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="3dp">
            <TextView
                android:id="@+id/banner_name_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#A0B8AD"
                android:textSize="10.5sp" />
            <TextView
                android:id="@+id/banner_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04:20"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/banner_box_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/banner_prayer_normal_bg"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="3dp">
            <TextView
                android:id="@+id/banner_name_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="#A0B8AD"
                android:textSize="10.5sp" />
            <TextView
                android:id="@+id/banner_time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11:58"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/banner_box_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/banner_prayer_normal_bg"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="3dp">
            <TextView
                android:id="@+id/banner_name_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="#A0B8AD"
                android:textSize="10.5sp" />
            <TextView
                android:id="@+id/banner_time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03:22"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/banner_box_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/banner_prayer_normal_bg"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginEnd="3dp">
            <TextView
                android:id="@+id/banner_name_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="#A0B8AD"
                android:textSize="10.5sp" />
            <TextView
                android:id="@+id/banner_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:55"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/banner_box_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/banner_prayer_normal_bg"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">
            <TextView
                android:id="@+id/banner_name_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="#A0B8AD"
                android:textSize="10.5sp" />
            <TextView
                android:id="@+id/banner_time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:15"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quran Wird Row -->
    <TextView
        android:id="@+id/banner_expanded_wird"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/banner_info_row_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="📖 الورد: ص 142 إلى 146 • متبقي 4 صفحات"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:layout_marginBottom="4dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Daily Dhikr Row -->
    <TextView
        android:id="@+id/banner_expanded_dhikr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/banner_info_row_bg"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="📿 ذكر الوقت: «سُبْحَانَ اللَّهِ وَبِحَمْدِهِ»"
        android:textColor="#E5C365"
        android:textSize="11sp"
        android:layout_marginBottom="6dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:id="@+id/banner_expanded_actions_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/banner_btn_wird"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/banner_btn_action"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="📖 الورد"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/banner_btn_azkar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/banner_btn_action"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="📿 الأذكار"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/banner_btn_prayers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/banner_btn_action"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="🕌 المواقيت"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
