<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_medium"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_emerald"
    android:padding="14dp">

    <!-- Top Info Row: Category Badge + Next Prayer Badge -->
    <LinearLayout
        android:id="@+id/med_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Category Badge -->
        <TextView
            android:id="@+id/med_category_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="أدعية قرآنية"
            android:textColor="#5CDBB5"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Next Prayer Badge -->
        <LinearLayout
            android:id="@+id/med_prayer_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_crescent_moon"
                android:tint="#E2BE78"
                android:layout_marginEnd="4dp"
                android:contentDescription="صلاة" />

            <TextView
                android:id="@+id/med_prayer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب 06:15 م"
                android:textColor="#E2BE78"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dhikr Text in Center -->
    <TextView
        android:id="@+id/med_widget_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/med_top_bar"
        android:layout_above="@+id/med_bottom_bar"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:text="رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="@font/amiri_regular"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- Bottom Bar: Source + Next Dhikr Button -->
    <LinearLayout
        android:id="@+id/med_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/med_widget_source"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="سورة البقرة: 201"
            android:textColor="#8CAFA0"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Next Dhikr Button -->
        <TextView
            android:id="@+id/med_btn_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_secondary"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="ذكر آخر ↺"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</RelativeLayout>
